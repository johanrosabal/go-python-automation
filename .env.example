# =============================================================================
# Framework Local Secrets & Master Encryption Key (.env.example)
# =============================================================================
# Copy this file to `.env` (which is ignored by Git) to control your keys locally.
#
# 1. Master Key for `ENC:...` encrypted passwords in YAML files:
#    Generate a new key anytime with:
#      python -m core.utils.base64_utils genkey
#    Encrypt a password with:
#      python -m core.utils.base64_utils enc "my_password"
FRAMEWORK_SECRET_KEY=replace_with_your_generated_master_key

# 2. Optional Environment-Specific Password Overrides (if using ${SAUCE_PASSWORD:...}):
# SAUCE_PASSWORD=secret_sauce

